# ============================================================================
# UNEFA StudyOS - Configuración de Base de Datos (Supabase)
# ============================================================================
# Por defecto, el sistema funciona 100% EN MEMORIA (con persistencia en LocalStorage).
# Cuando quieras conectar tu proyecto de Supabase:
# 1. Copia este archivo a `.env.local`
# 2. Ejecuta el script SQL ubicado en `supabase/schema.sql` dentro del SQL Editor de Supabase
# 3. Coloca tus credenciales aquí abajo y cambia NEXT_PUBLIC_STORAGE_MODE="supabase"
# ============================================================================

NEXT_PUBLIC_STORAGE_MODE="memory" # "memory" | "supabase"
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-anon-key-de-supabase"
